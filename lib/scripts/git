#!/bin/bash
# Git auth shim -- injects GITHUB_TOKEN credentials for network operations
# inside the configured OpenClaw repo so the agent can use plain git commands.

REAL_GIT_HINT="@@REAL_GIT@@"
OPENCLAW_REPO_ROOT="@@OPENCLAW_REPO_ROOT@@"
ASKPASS_PATH="@@ASKPASS_PATH@@"

same_path() {
  local left_path right_path
  left_path="$(readlink -f "$1" 2>/dev/null || printf '%s' "$1")"
  right_path="$(readlink -f "$2" 2>/dev/null || printf '%s' "$2")"
  [ "$left_path" = "$right_path" ]
}

resolve_real_git() {
  local self_path candidate
  self_path="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  for candidate in \
    "${ALPHACLAW_REAL_GIT:-}" \
    "$REAL_GIT_HINT" \
    "/usr/bin/git" \
    "/bin/git" \
    "/usr/libexec/git-core/git" \
    "/usr/local/bin/git.real"
  do
    [ -n "$candidate" ] || continue
    [ -x "$candidate" ] || continue
    same_path "$candidate" "$self_path" && continue
    printf '%s\n' "$candidate"
    return 0
  done

  if command -v which >/dev/null 2>&1; then
    while IFS= read -r candidate; do
      [ -n "$candidate" ] || continue
      [ -x "$candidate" ] || continue
      same_path "$candidate" "$self_path" && continue
      printf '%s\n' "$candidate"
      return 0
    done <<EOF
$(which -a git 2>/dev/null || true)
EOF
  fi

  return 1
}

canonicalize_path() {
  local target_path resolved_path
  target_path="$1"
  [ -n "$target_path" ] || return 1

  if [ -d "$target_path" ]; then
    resolved_path="$(cd "$target_path" 2>/dev/null && pwd -P)" || resolved_path=""
    if [ -n "$resolved_path" ]; then
      printf '%s\n' "$resolved_path"
      return 0
    fi
  fi

  resolved_path="$(readlink -f "$target_path" 2>/dev/null || true)"
  if [ -n "$resolved_path" ]; then
    printf '%s\n' "$resolved_path"
    return 0
  fi

  printf '%s\n' "$target_path"
}

scan_global_args() {
  local effective_pwd
  effective_pwd="$(pwd)"
  GLOBAL_ARG_COUNT=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -C)
        shift
        [ "$#" -gt 0 ] || break
        GLOBAL_ARG_COUNT=$((GLOBAL_ARG_COUNT + 1))
        case "$1" in
          /*) effective_pwd="$1" ;;
          *) effective_pwd="$effective_pwd/$1" ;;
        esac
        ;;
      -c|--exec-path|--git-dir|--work-tree|--namespace|--config-env|--super-prefix|--list-cmds|--attr-source)
        shift
        [ "$#" -gt 0 ] || break
        GLOBAL_ARG_COUNT=$((GLOBAL_ARG_COUNT + 1))
        ;;
      --exec-path=*|--git-dir=*|--work-tree=*|--namespace=*|--config-env=*|--super-prefix=*|--list-cmds=*|--attr-source=*)
        ;;
      --)
        break
        ;;
      -*)
        ;;
      *)
        break
        ;;
    esac
    GLOBAL_ARG_COUNT=$((GLOBAL_ARG_COUNT + 1))
    shift
  done

  SCANNED_PWD="$effective_pwd"
}

physical_dir() {
  local resolved_dir
  resolved_dir="$(cd -P "$1" 2>/dev/null && pwd -P && printf x)" || return 1
  resolved_dir="${resolved_dir%x}"
  resolved_dir="${resolved_dir%$'\n'}"
  case "$resolved_dir" in
    ""|*$'\n'*) return 1 ;;
  esac
  printf '%s\n' "$resolved_dir"
}

physical_parent_path() {
  local target_path ancestor remainder resolved_ancestor
  target_path="$1"
  while [ "${#target_path}" -gt 1 ] && [ "${target_path%/}" != "$target_path" ]; do
    target_path="${target_path%/}"
  done
  remainder="${target_path##*/}"
  ancestor="${target_path%/*}"
  [ -n "$ancestor" ] || ancestor="/"
  while [ ! -d "$ancestor" ]; do
    remainder="${ancestor##*/}/$remainder"
    ancestor="${ancestor%/*}"
    [ -n "$ancestor" ] || ancestor="/"
  done
  resolved_ancestor="$(physical_dir "$ancestor")" || return 1
  printf '%s/%s\n' "${resolved_ancestor%/}" "$remainder"
}

inside_worktree() {
  case "$1" in
    "$2"|"$2"/*) return 0 ;;
    *) return 1 ;;
  esac
}

map_into_worktree() {
  local target_path worktree mapped_path
  target_path="$1"
  worktree="$2"
  inside_worktree "$target_path" "$worktree" && return 1
  mapped_path="$(physical_parent_path "$target_path")" || return 1
  if inside_worktree "$mapped_path" "$worktree"; then
    printf '%s\n' "$mapped_path"
    return 0
  fi
  [ -d "$target_path" ] || return 1
  mapped_path="$(physical_dir "$target_path")" || return 1
  inside_worktree "$mapped_path" "$worktree" || return 1
  printf '%s\n' "$mapped_path"
}

takes_option_value() {
  local option_arg value_long value_short cluster letter long_option
  option_arg="$1"
  value_long="$2"
  value_short="$3"
  case "$option_arg" in
    --*=*) return 1 ;;
    --*)
      for long_option in $value_long; do
        case "$long_option" in
          "$option_arg"*) return 0 ;;
        esac
      done
      return 1
      ;;
    -?*)
      [ -n "$value_short" ] || return 1
      cluster="${option_arg#-}"
      while [ -n "$cluster" ]; do
        letter="${cluster%"${cluster#?}"}"
        cluster="${cluster#?}"
        case "$value_short" in
          *"$letter"*) [ -z "$cluster" ]; return ;;
        esac
      done
      ;;
  esac
  return 1
}

map_symlinked_path_args() {
  local subcommand value_long value_short index arg previous_arg after_dashdash worktree mapped_path
  subcommand="${GIT_ARGS[$GLOBAL_ARG_COUNT]:-}"
  value_long=""
  value_short=""
  case "$subcommand" in
    commit)
      value_long=" --message --file --reuse-message --reedit-message --author --date --fixup --squash --template --trailer --cleanup "
      value_short="mFCct"
      ;;
    stash)
      [ "${GIT_ARGS[$((GLOBAL_ARG_COUNT + 1))]:-}" = "save" ] && return 0
      value_long=" --message "
      value_short="m"
      ;;
    diff|log|show)
      value_long=" --grep --author --committer --ignore-matching-lines "
      value_short="SGOIL"
      ;;
    blame|annotate)
      value_short="L"
      ;;
    clean)
      value_long=" --exclude "
      value_short="e"
      ;;
    ls-files)
      value_long=" --exclude --exclude-from --format "
      value_short="xX"
      ;;
    add|rm|mv|restore|checkout|reset|status|check-ignore) ;;
    *) return 0 ;;
  esac

  for arg in "${GIT_ARGS[@]}"; do
    case "$arg" in
      *[[:cntrl:]]*) return 0 ;;
    esac
  done

  worktree=""
  previous_arg=""
  after_dashdash=0
  index=$((GLOBAL_ARG_COUNT + 1))
  while [ "$index" -lt "${#GIT_ARGS[@]}" ]; do
    arg="${GIT_ARGS[$index]}"
    index=$((index + 1))
    if [ "$after_dashdash" = 0 ]; then
      if [ -n "$previous_arg" ] && takes_option_value "$previous_arg" "$value_long" "$value_short"; then
        previous_arg=""
        continue
      fi
      if [ "$arg" = "--" ]; then
        after_dashdash=1
        continue
      fi
      previous_arg="$arg"
    fi
    case "$arg" in
      /*) ;;
      *) continue ;;
    esac
    [ "$(physical_parent_path "$arg")" = "$arg" ] && [ ! -L "$arg" ] && continue
    if [ -z "$worktree" ]; then
      worktree="$("$REAL_GIT" "${GIT_ARGS[@]:0:$GLOBAL_ARG_COUNT}" rev-parse --show-toplevel 2>/dev/null)" || return 0
      [ -n "$worktree" ] || return 0
      worktree="$(canonicalize_path "$worktree")"
    fi
    mapped_path="$(map_into_worktree "$arg" "$worktree")" || continue
    GIT_ARGS[$((index - 1))]="$mapped_path"
  done
}

in_openclaw_root() {
  local candidate_path resolved_repo_root resolved_candidate_path
  candidate_path="$1"
  if [ -z "$OPENCLAW_REPO_ROOT" ]; then
    return 1
  fi
  resolved_repo_root="$(canonicalize_path "$OPENCLAW_REPO_ROOT")"
  resolved_candidate_path="$(canonicalize_path "$candidate_path")"
  case "$resolved_candidate_path" in
    "$resolved_repo_root"|"${resolved_repo_root}"/*) return 0 ;;
    *) return 1 ;;
  esac
}

REAL_GIT="$(resolve_real_git || true)"
if [ -z "$REAL_GIT" ]; then
  echo "alphaclaw git shim: real git binary not found" >&2
  exit 127
fi

GIT_ARGS=("$@")
scan_global_args "$@"
EFFECTIVE_PWD="$(canonicalize_path "$SCANNED_PWD")"
map_symlinked_path_args

if [ -z "${GITHUB_TOKEN:-}" ] && in_openclaw_root "$EFFECTIVE_PWD" && [ -f "$OPENCLAW_REPO_ROOT/.env" ]; then
  # Extract ONLY GITHUB_TOKEN — never source (issue #26 sibling): sourcing
  # executed $(…) in any .env value with the agent's privileges, and a value
  # with spaces silently dropped the var. Last assignment wins (matching the
  # JS reader); one layer of matching surrounding quotes is stripped, and
  # inside single quotes bash's '\'' escape becomes '.
  # NOTE: keep in sync with the twin parser in lib/setup/hourly-git-sync.sh.
  while IFS= read -r _env_line || [ -n "$_env_line" ]; do
    case "$_env_line" in
      GITHUB_TOKEN=*) ;;
      *) continue ;;
    esac
    _env_val="${_env_line#GITHUB_TOKEN=}"
    case "$_env_val" in
      \"*\") _env_val="${_env_val#\"}"; _env_val="${_env_val%\"}" ;;
      \'*\') _env_val="${_env_val#\'}"; _env_val="${_env_val%\'}"; _env_val="${_env_val//"'\\''"/"'"}" ;;
    esac
    GITHUB_TOKEN="$_env_val"
    export GITHUB_TOKEN
  done < "$OPENCLAW_REPO_ROOT/.env"
fi

if [ "${ALPHACLAW_GIT_NO_AUTH:-}" = "1" ] || [ -z "${GITHUB_TOKEN:-}" ] || ! in_openclaw_root "$EFFECTIVE_PWD"; then
  exec "$REAL_GIT" "${GIT_ARGS[@]}"
fi

export GIT_TERMINAL_PROMPT=0
export GIT_ASKPASS="$ASKPASS_PATH"
exec "$REAL_GIT" "${GIT_ARGS[@]}"
