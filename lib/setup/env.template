# OpenClaw Environment Variables
# Edit via the Setup UI or directly in this file

# --- AI Provider (at least one required) ---
ANTHROPIC_API_KEY=
ANTHROPIC_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# --- GitHub (required) ---
GITHUB_TOKEN=
GITHUB_WORKSPACE_REPO=

# --- Setup UI auth (required) ---
SETUP_PASSWORD=

# --- Channels (at least one required) ---
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- Tools (optional) ---
BRAVE_API_KEY=
CLAUDE_CODE_ROUTINE_URL=
CLAUDE_CODE_ROUTINE_TOKEN=

# --- Advanced: gateway child-process environment (optional) ---
# The OpenClaw gateway/agent receives an allowlisted subset of the environment;
# AlphaClaw-internal secrets (SETUP_PASSWORD, webhook/platform tokens) are never
# passed. If a deployment needs an extra key to reach the gateway, list it here
# (KEY names or PREFIX* globs, comma/space separated). Set from your platform's
# deployment env, not via the dashboard.
# ALPHACLAW_GATEWAY_ENV_PASSTHROUGH=
