{
  "$schema": "https://github.com/garrytan/gstack/docs/pregate.md#pregate-v1",
  "runner": "npx vitest run {files}",
  "dependencies": {
    "package-lock.json": [
      "tests/server/alphaclaw-version.test.js"
    ],
    "tests/browser/**": []
  },
  "run_profiles": {
    "ci/test-24": {
      "workflow": "ci.yml",
      "events": [
        "pull_request",
        "push"
      ],
      "jobs": [
        "test (24)"
      ],
      "artifact": "tested-tree",
      "os": "Linux"
    }
  },
  "ship_lanes_from": {
    "npm test": {
      "profiles": [
        "ci/test-24"
      ],
      "inventory": "git ls-files -- 'tests/*.test.js' | grep -vE '^tests/(live|container)/'"
    },
    "npx vitest run tests/server/guards": {
      "profiles": [
        "ci/test-24"
      ],
      "inventory": "git ls-files -- 'tests/server/guards/*.test.js'"
    }
  },
  "allowlist": [
    {
      "finding": "env.kv",
      "paths": [
        "lib/server/relay/bridge-store.js"
      ],
      "pattern": "row\\.session_key,?\\s*$",
      "reason": "field mapping: a relay row's OpenClaw session key name (agent:<id>:relay-<sender>), not a credential"
    },
    {
      "finding": "env.kv",
      "paths": [
        "lib/server/relay/bridge.js",
        "lib/server/routes/relay.js"
      ],
      "pattern": "row\\.sessionKey,?\\s*$",
      "reason": "field mapping: a relay row's OpenClaw session key name (agent:<id>:relay-<sender>), not a credential"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tests/live/*.e2e.test.js"
      ],
      "pattern": "local-model-fixture\",?\\s*$",
      "reason": "the live tier's mock-model provider key, a fixed dummy string every live test uses"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tests/server/gateway.test.js"
      ],
      "pattern": "sk-sure-secret-token\",?\\s*$",
      "reason": "the REMOTE_MCP test fixture token gateway.test.js asserts never reaches openclaw.json"
    },
    {
      "finding": "env.kv",
      "paths": [
        "lib/server/relay/oauth-provider.js"
      ],
      "pattern": "(?:accessToken|refreshToken),?\\s*$",
      "reason": "RFC 6749 token response field names (access_token, refresh_token) mapped from local variables; the values are minted at runtime, never literals"
    },
    {
      "finding": "env.kv",
      "paths": [
        "lib/public/js/login.js"
      ],
      "pattern": "(?:inviteToken|passwordEl\\.value),?\\s*$",
      "reason": "the login and accept-invite request body fields, filled from the invite link and the password input at runtime; no literal value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tests/server/guards/scanners.js"
      ],
      "pattern": "`\\$\\{relPath\\}::\\$\\{matches\\.length\\}`,?\\s*$",
      "reason": "a structural guard's offender key (file path and hit count), not a credential"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tests/server/origin-guard.test.js"
      ],
      "pattern": "origin-secret\";\\s*$",
      "reason": "a dummy SETUP_PASSWORD the origin-guard tests sign in with; never a deployed value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tests/server/web-hardening-real-server.test.js"
      ],
      "pattern": "kPassword,?\\s*$",
      "reason": "the real-server test's child env, set from the file's dummy kPassword constant"
    },
    {
      "finding": "env.kv",
      "paths": [
        "tests/server/web-hardening-real-server.test.js"
      ],
      "pattern": "String\\(res\\.headers\\.get\\(\"set-cookie\"\\) \\|\\| \"\"\\)\\.split\\(\";\"\\)\\[0\\];\\s*$",
      "reason": "reads the session cookie a test login just received, to send it on later requests; no literal value"
    }
  ]
}
